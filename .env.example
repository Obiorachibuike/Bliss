# ─── Bliss — Pesles AI (Agnes AI) + CVRON ────────────────────────────
# Bliss works with NO configuration for CVRON (key-less).
# For Pesles AI / Agnes AI streaming chat, image & video (free $0 promo):
# Get a free API key (no credit card): sign up at platform.agnes-ai.com → API Keys → create key.
# Configure:
#   cp .env.example .env
# Then add your key(s) as numbered variables — add as many as you want, server detects them all automatically:
#   AGNES_API_KEY_1=sk-...
#   AGNES_API_KEY_2=sk-...
#   AGNES_API_KEY_3=sk-...
#   # ...just keep numbering to add more
#
# Comma-separated AGNES_API_KEYS and single AGNES_API_KEY also work:
#   AGNES_API_KEYS=sk-...,sk-...
#   AGNES_API_KEY=sk-...
#
# Key pool: server rotates keys round-robin and fails over automatically
#   - 429 rate-limit → benched 60s
#   - 402 out of quota → benched 1h
#   - 401 invalid → disabled permanently
# Video status polling always uses same key that created task (account-scoped).
# Frontend never sees keys, provider names, or technical error details — those go to server console only.

# ─── Agnes AI ──────────────────────────────────────────────────────────
# Optional: override Agnes base URL (default https://apihub.agnes-ai.com/v1)
# AGNES_API_BASE="https://apihub.agnes-ai.com/v1"
# AGNES_API_HOST="https://apihub.agnes-ai.com"

# ─── CVRON FreeAiAPIs (key-less, fallback) ────────────────────────────
# Optional: point Bliss at a mirror or self-hosted gateway for the same CVRON API surface
# NEXT_PUBLIC_AI_API_HOST="https://cvron.alwaysdata.net"
# Server-only alias, same meaning, only read in route handlers.
# BLESS_API_BASE="https://cvron.alwaysdata.net"

# ─── General ──────────────────────────────────────────────────────────
# PORT=3000
