APP_ENV=development
API_PORT=8000
# web: browser files are uploaded to this server with explicit consent.
# desktop: worker binds loopback and requires a per-launch secret generated by Rust.
CLIPSHIP_RUNTIME=web
AI_MODE=local
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Local model caches; models are installed only on explicit request.
MODEL_DIR=
# Optional transcript-only providers. Never put secrets in VITE_* variables.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
DATA_DIR=
FFMPEG_PATH=
FFPROBE_PATH=
# Limit browser uploads in bytes (default 20 GiB).
MAX_UPLOAD_BYTES=21474836480
# Deployment behind a reverse proxy: configure authentication before exposing to the internet.
CLIPSHIP_ACCESS_TOKEN=
# Explicit allowlist for custom remote provider origins (comma-separated HTTPS origins).
AI_ALLOWED_ENDPOINTS=
LICENSE_API_URL=
